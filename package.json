{
  "name": "turinglab",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run check:deploy",
    "deploy": "gh-pages -d dist --nojekyll --dotfiles",
    "check:deploy": "npm run test && npm run build && npm run validate:deploy && npm run test:e2e:production",
    "validate:deploy": "node scripts/validate-deploy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.js --workers=2",
    "validate:levels": "vite-node scripts/validate_levels.js",
    "cleanup:e2e": "node scripts/cleanup_e2e_telemetry.js"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "playwright": "^1.61.0",
    "vite": "^8.0.12",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.6"
  }
}
